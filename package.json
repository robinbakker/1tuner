{
  "name": "1tuner",
  "private": true,
  "version": "3.2.1",
  "description": "1 web app to listen to radio and podcasts",
  "author": "Robin Bakker",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "prefetch": "node ./scripts/fetchPodcasts.js",
    "process-radio-podcasts": "node ./scripts/processRadioPodcasts.js",
    "prebuild": "npm run prefetch && npm run process-radio-podcasts",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 120,
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "fast-xml-parser": "^5.11.2",
    "idb": "^8.0.4",
    "lucide-preact": "^1.55.0",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2",
    "simple-icons": "^16.35.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/chromecast-caf-sender": "^1.0.11",
    "@types/node": "^26.6.5",
    "clsx": "^2.1.1",
    "country-flag-emoji-polyfill": "0.1.8",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.29",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0"
  }
}
